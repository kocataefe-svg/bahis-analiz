# Supabase (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Veri kaynaklari
ODDS_API_KEY=
GROQ_API_KEY=
# Arastir butonu (Google Search grounding) VE Bahis Analizcisi/Surpriz
# Yorumcu personalarinin arka plan uretimi icin kullanilir. Tek anahtar
# yeterli (GEMINI_API_KEY), ama ucretsiz kota (ozellikle arastirmanin
# kullandigi grounding kotasi) kolay dolabiliyor - ayri Google Cloud
# projelerinden birden fazla ucretsiz anahtar alip GEMINI_API_KEYS'e
# virgulle ayirarak eklenirse, biri dolunca otomatik siradakine gecilir.
# GEMINI_API_KEYS varsa GEMINI_API_KEY yok sayilir.
GEMINI_API_KEY=
# GEMINI_API_KEYS=anahtar1,anahtar2,anahtar3

# GitHub Actions'in senkron route'larini tetiklerken kullandigi paylasilan sir
# (kendiniz uretin, orn: openssl rand -hex 32) - Vercel'e ve GitHub repo secret'ina
# ayni degeri eklemeniz gerekir
CRON_SECRET=
