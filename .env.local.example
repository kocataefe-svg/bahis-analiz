# Supabase (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Veri kaynaklari
ODDS_API_KEY=
GROQ_API_KEY=
# Arastir butonunun web aramasi icin kullanilir (tavily.com'dan ucretsiz
# alinir, kredi karti istemez). Gemini'nin cok dar/paylasimli grounding
# kotasinin yerini alir - bkz. src/lib/web-research.ts, src/lib/tavily.ts.
TAVILY_API_KEY=
# Bahis Analizcisi/Surpriz Yorumcu personalarinin arka plan uretimi icin
# kullanilir (duz JSON uretimi, grounding KULLANMAZ - bkz.
# src/lib/gemini-analysis.ts). Tek anahtar yeterli (GEMINI_API_KEY), ama
# istenirse ayri Google Cloud projelerinden birden fazla ucretsiz anahtar
# alip GEMINI_API_KEYS'e virgulle ayirarak eklenebilir - biri kota
# hatasi verince otomatik siradakine gecilir. GEMINI_API_KEYS varsa
# GEMINI_API_KEY yok sayilir.
GEMINI_API_KEY=
# GEMINI_API_KEYS=anahtar1,anahtar2,anahtar3

# GitHub Actions'in senkron route'larini tetiklerken kullandigi paylasilan sir
# (kendiniz uretin, orn: openssl rand -hex 32) - Vercel'e ve GitHub repo secret'ina
# ayni degeri eklemeniz gerekir
CRON_SECRET=
